# .env.example - Gerekli ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri kendi ortamınıza göre doldurun

# Veritabanı
DB_URL=JDBC_URLINIZI_BURAYA_YAZIN
DB_USERNAME=KULLANICI_ADINIZI_BURAYA_YAZIN
DB_PASSWORD=SIFRENIZI_BURAYA_YAZIN

# JWT
JWT_SECRET=GUVENLI_BIR_SECRET_KEY_BURAYA_YAZIN
JWT_EXPIRATION=TOKEN_SURESI_MILISANIYE_CINSINDEN_BURAYA_YAZIN

# AI - Gemini
GEMINI_API_KEY=GEMINI_API_KEYINIZI_BURAYA_YAZIN
